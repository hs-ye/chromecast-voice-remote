From 4077e2ed08afc4a3e6c1061a05aa532ea2b3a62e Mon Sep 17 00:00:00 2001
From: hs-ye <ye.hansang@gmail.com>
Date: Mon, 19 Oct 2026 16:56:22 +1100
Subject: [PATCH 10/10] fix(atvv): don't treat tail frames as a new press; make
 trigger idempotent

A late audio frame arriving right after AUDIO_STOP re-entered Streaming via
the implicit-start path and fired a second trigger. With a toggle-only
dictation tool that left it recording, so the next press stopped it and
every later press/release was inverted.

- ignore frames for 750 ms after a stream ends, and require three
  consecutive frames before an implicit start
- pass the direction in ATVVOICE_TRIGGER (start/stop) instead of leaving
  the consumer to infer it
- fire stop when a session ends by disconnect while still streaming
- add contrib/handy-remote-trigger: an idempotent wrapper that reads
  Handy's last TranscribeAction::start/stop log line and only toggles when
  the requested state differs
---
 contrib/handy-remote-trigger |  74 +++++++++++++++++++++
 src/atvv.rs                  | 125 +++++++++++++++++++++++++----------
 2 files changed, 165 insertions(+), 34 deletions(-)
 create mode 100755 contrib/handy-remote-trigger

diff --git a/contrib/handy-remote-trigger b/contrib/handy-remote-trigger
new file mode 100755
index 0000000..f481d77
--- /dev/null
+++ b/contrib/handy-remote-trigger
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# Idempotent start/stop bridge between atvvoice and Handy.
+#
+# atvvoice sets ATVVOICE_TRIGGER=start|stop on every streaming transition.
+# Handy only exposes a toggle, so read Handy's real state from its log (the
+# last TranscribeAction::start/stop line) and only toggle when it differs.
+# That makes "press" always mean recording, regardless of any prior drift.
+set -euo pipefail
+
+action="${ATVVOICE_TRIGGER:-${1:-}}"
+case "$action" in
+    start | stop) ;;
+    *)
+        echo "usage: $0 start|stop (or set ATVVOICE_TRIGGER)" >&2
+        exit 2
+        ;;
+esac
+
+pgrep -x handy >/dev/null 2>&1 || exit 0
+
+log="${HANDY_LOG:-$HOME/.local/share/com.pais.handy/logs/handy.log}"
+state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/handy-remote"
+mkdir -p "$state_dir"
+
+# Serialise start/stop so a fast press/release cannot race on the log.
+exec 9>"$state_dir/lock"
+flock 9
+
+last_action() {
+    local line act ts epoch now
+    line=$(tail -n 2000 "$log" 2>/dev/null |
+        grep -E 'TranscribeAction::(start|stop) called' |
+        tail -1) || return 0
+    [ -n "$line" ] || return 0
+    act=$(printf '%s\n' "$line" | sed -nE 's/.*TranscribeAction::(start|stop) called.*/\1/p')
+    ts=$(printf '%s\n' "$line" | sed -nE 's/^\[([0-9-]+)\]\[([0-9:]+)\].*/\1 \2/p')
+    if [ "$act" = start ] && [ -n "$ts" ]; then
+        epoch=$(date -u -d "$ts" +%s 2>/dev/null || echo 0)
+        now=$(date -u +%s)
+        # A "start" older than five minutes is stale, not a live press.
+        if [ "$epoch" -gt 0 ] && [ $((now - epoch)) -gt 300 ]; then
+            act=stop
+        fi
+    fi
+    printf '%s' "$act"
+}
+
+current=$(last_action)
+if [ -z "$current" ]; then
+    current=$(cat "$state_dir/state" 2>/dev/null || true)
+fi
+
+# Already in the requested state: nothing to do. This is the fix for the
+# inverted press/release behaviour.
+if [ "$current" = "$action" ]; then
+    exit 0
+fi
+
+handy --toggle-transcription >/dev/null 2>&1 || {
+    echo "handy-remote-trigger: handy --toggle-transcription failed" >&2
+    exit 1
+}
+printf '%s' "$action" >"$state_dir/state"
+
+# Handy writes its log asynchronously; confirm the toggle landed.
+for _ in $(seq 1 10); do
+    sleep 0.02
+    if [ "$(last_action)" = "$action" ]; then
+        exit 0
+    fi
+done
+
+echo "handy-remote-trigger: wanted $action, log last=$(last_action)" >&2
+exit 0
