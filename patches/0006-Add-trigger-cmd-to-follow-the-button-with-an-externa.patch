+                    trigger_cmd: None,
                 },
             )
             .await
@@ -1182,6 +1224,7 @@ mod tests {
                     state_tx: Some(&state_tx),
                     consumer_rx: Some(consumer_rx),
                     mic_on_demand: true,
+                    trigger_cmd: None,
                 },
             )
             .await
@@ -1267,6 +1310,7 @@ mod tests {
