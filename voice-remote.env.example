# voice-remote environment (copy to voice-remote.env to use)

# MAC of the Chromecast Voice Remote. Leave empty to auto-detect from bluetoothctl.
MAC=

# Where to install the binaries.
PREFIX=$HOME/.local

# Install the udev hwdb button remap. Set to 0 to skip.
DO_HWDB=1

# Merge Handy's settings. Set to 0 to skip.
DO_HANDY=1

# Make the virtual mic the system default input. Opt-in: while it is the
# default, apps that do not pick their own input receive silence unless the
# remote's voice button is held.
SET_DEFAULT=0
